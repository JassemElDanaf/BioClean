# Copy to .env and adjust if needed - every value here already has a
# working default in app/core/config.py, so .env is optional for local
# dev unless you're changing something.

DATABASE_URL=postgresql://bioclean:bioclean@localhost:5432/bioclean
CORS_ORIGINS=["http://localhost:3000"]
API_V1_PREFIX=/api/v1
CURRENT_USER=admin
# Login users (username -> numbers-only password/role) are set in
# app/core/config.py's `users` dict, not here - edit that file to
# add/remove people or change passwords.
