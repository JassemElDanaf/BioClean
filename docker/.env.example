# Copy this file to `.env` (in this same docker/ folder) and fill in real values.
# `.env` is gitignored - never commit real secrets.
#
# Reference for every variable: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md

# --- Pinned versions (must match docker/apps.json) ---
ERPNEXT_VERSION=v16.35.0

# --- Custom image (built from this repo's docker/apps.json - see DEPLOY.md "Build the image") ---
CUSTOM_IMAGE=bioclean
CUSTOM_TAG=v16.35.0
PULL_POLICY=missing

# --- Database ---
DB_PASSWORD=CHANGE_ME_TO_A_REAL_SECRET

# --- Site ---
# Must match the site created with `bench new-site` inside the container.
SITE_NAME=bioclean.localhost
ADMIN_PASSWORD=CHANGE_ME_TO_A_REAL_SECRET

# --- HTTP port (noproxy override) ---
HTTP_PUBLISH_PORT=8080

# --- Gunicorn tuning (defaults are fine for this scale) ---
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Backups ---
# Cron expression understood by ofelia. Default: once a day (see plan decision).
# Examples: "@daily", "@every 2d" (every 2 days), "0 0 3 * * *" (03:00 daily)
BACKUP_CRONSTRING=@daily

# --- rclone / Google Drive backup upload (set up separately on the host - see DEPLOY.md "Backups") ---
RCLONE_REMOTE_NAME=gdrive-bioclean

# --- WhatsApp alerting (see DEPLOY.md "Monitoring & alerts") ---
WHATSAPP_ALERT_WEBHOOK_URL=
WHATSAPP_ALERT_TO_NUMBER=
